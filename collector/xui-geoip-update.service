[Unit]
Description=Update MaxMind GeoLite2 and QQWry databases for X-UI collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/update-xui-geoip
ExecStartPost=/bin/systemctl try-restart xui-connection-collector.service
User=root
Group=root
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=-/etc/xui-geoip.conf
ReadWritePaths=/var/lib/GeoIP
